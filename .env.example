# .env.example
# App Config
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Configuration
# Options: cerebras | openrouter | huggingface
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your_free_tier_key_here

# TigerGraph Configuration
TG_HOST=https://your-savanna-instance.tigergraph.com
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_SECRET=your_secret_here
TG_GRAPH_NAME=FraudGraph