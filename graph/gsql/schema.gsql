// graph/gsql/schema.gsql
USE GRAPH FraudGraph
DROP JOB ALL
DROP GRAPH FraudGraph

CREATE VERTEX Customer (PRIMARY_ID id STRING, account_age INT, identity_status STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Card (PRIMARY_ID id STRING, card_type STRING, current_status STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Transaction (PRIMARY_ID id STRING, amount DOUBLE, ts DATETIME, channel STRING, risk_score DOUBLE) WITH primary_id_as_attribute="true"
CREATE VERTEX DeviceProfile (PRIMARY_ID id STRING, device_type STRING, is_new BOOL) WITH primary_id_as_attribute="true"
CREATE VERTEX EmailDomain (PRIMARY_ID id STRING, domain STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX BillingRegion (PRIMARY_ID id STRING, region_code STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX ClosedCase (PRIMARY_ID id STRING, verdict STRING, pattern STRING, summary STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX FraudCase (PRIMARY_ID id STRING, status STRING, verdict STRING, fraud_probability DOUBLE, pattern STRING, exposure_usd DOUBLE) WITH primary_id_as_attribute="true"

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card)
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction)
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile)
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain)
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion)
CREATE DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction)
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction, FROM FraudCase, TO Transaction)
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card, FROM FraudCase, TO Card)
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card, FROM FraudCase, TO Card)
CREATE DIRECTED EDGE RELATED_TO (FROM FraudCase, TO DeviceProfile)
CREATE DIRECTED EDGE SIMILAR_TO (FROM FraudCase, TO ClosedCase, similarity_score DOUBLE)

CREATE GRAPH FraudGraph (*)